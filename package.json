{
  "name": "n8n-nodes-brault",
  "version": "0.1.0",
  "description": "Brault node for n8n: automate your digital asset library with the Brault Public API (files, folders, boards, comments, review links, transfers, webhooks).",
  "license": "MIT",
  "homepage": "https://developers.brault.app",
  "keywords": ["n8n-community-node-package", "brault", "dam", "digital asset management", "creative", "review"],
  "author": { "name": "Brault", "email": "hello@brault.app" },
  "repository": { "type": "git", "url": "https://github.com/Brault-app/n8n-nodes-brault.git" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "jest",
    "scan": "npx @n8n/scan-community-package n8n-nodes-brault",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/BraultApi.credentials.js"],
    "nodes": ["dist/nodes/Brault/Brault.node.js", "dist/nodes/BraultTrigger/BraultTrigger.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.47.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "eslint": "9.39.4",
    "jest": "^29.7.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
